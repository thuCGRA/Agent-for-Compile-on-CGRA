diff --git a/include/morpher/mapper/LLMMapper.h b/include/morpher/mapper/LLMMapper.h
new file mode 100755
index 0000000..836a7fc
--- /dev/null
+++ b/include/morpher/mapper/LLMMapper.h
@@ -0,0 +1,173 @@
+/*
+ * LLMMapper.h
+ *
+ *  A PathFinderMapper variant whose per-node candidate queue is constrained by
+ *  an external placement hint (the "pins" produced by the python agent), plus a
+ *  verify mode that builds the mapping from an external placement + route set
+ *  and only checks it (no search).
+ *
+ *  Design notes:
+ *   - pins mode: placement is decided outside, routing inside: the hint only
+ *     removes or re-orders entries of the candidate queue that
+ *     estimateRouting() built, so Route()/LeastCostPathAstar() are used
+ *     unchanged.
+ *   - verify mode: the placement (pins) and, optionally, the route of single
+ *     edges (coordinate paths) come from outside.  The mapper materialises the
+ *     mapping on the real port graph, honours every given route, falls back to
+ *     LeastCostPathAstar() for edges without a route, and reports conflicts
+ *     instead of asserting.
+ *   - no assert() is added on the external-input path: a bad hint must produce
+ *     a machine readable report, not a crash, because the agent loop consumes
+ *     the report.
+ */
+
+#include <morpher/mapper/PathFinderMapper.h>
+
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#ifndef LLMMAPPER_H_
+#define LLMMAPPER_H_
+
+namespace CGRAXMLCompile
+{
+
+struct PlacementPin
+{
+	bool set = false;
+	int node = -1;
+	int x = -1;
+	int y = -1;
+	int t = -1; // phase of the PE (PE::T), i.e. absolute lat % II
+	int lat = -1; // optional absolute latency; -1 = derive from the dfg edges
+};
+
+// One externally routed edge: "path" is the sequence of PE coordinates the
+// value walks through, starting at the source PE and ending at the destination
+// PE.  The network is time-multiplexed, so the phase of a hop is not part of the
+// path: the mapper searches the port graph for a legal realisation that arrives
+// at the destination at the cycle the consumer needs it.  HyCUBE forwards
+// through a neighbour within one cycle, so a hop does not cost a whole cycle and
+// the hop count is only a lower bound on the path length.
+struct RouteHint
+{
+	int from = -1;
+	int to = -1;
+	std::vector<std::pair<int, int>> coords;
+};
+
+struct MapConflict
+{
+	std::string type;  // placement | op | timing | route | port
+	int x = -1;
+	int y = -1;
+	int cycle = -1;
+	int from = -1;
+	int to = -1;
+	std::string port;
+	std::string msg;
+	// every edge that drives this port in this cycle: a caller can decide which
+	// one to give way instead of restarting the whole route set
+	std::vector<std::pair<int, int>> edgeList;
+	// the edge we would release, and what that means for the caller:
+	//   "reroute"   it is already flexible, rerun and A* will place it
+	//   "flex"      it is fixed, add it to "flex" and rerun
+	//   "no-flex"   releasing it is not possible (it is the only edge here)
+	std::pair<int, int> suggest = std::make_pair(-1, -1);
+	std::string suggestAction;
+};
+
+class LLMMapper : public PathFinderMapper
+{
+public:
+	enum PinsMode
+	{
+		PINS_OFF = 0,
+		PINS_STRICT = 1,
+		PINS_PREFER = 2,
+		PINS_REPAIR = 3
+	};
+
+	LLMMapper(std::string fName) : PathFinderMapper(fName)
+	{
+		mapping_method_name = "LLM";
+	}
+
+	void setPinsFile(std::string f) { pinsFileName = f; }
+	void setReportFile(std::string f) { reportFileName = f; }
+	void setRoutesFile(std::string f) { routesFileName = f; }
+	void setPinsMode(PinsMode m) { pinsMode = m; }
+	void setVerifyMode(bool v) { verifyMode = v; }
+	bool isVerifyMode() const { return verifyMode; }
+
+	bool loadPins();
+	bool loadRoutes();
+
+	// An edge listed in the routes file's "flex" array is routed by the internal
+	// A* even when a path was given for it, so a caller that gets a port conflict
+	// can promote the suggested edge and rerun instead of rebuilding every route.
+	bool isFlexEdge(int from, int to) const
+	{
+		return flexEdges.find(std::make_pair(from, to)) != flexEdges.end();
+	}
+
+	// Same search as method 0, but with the pinned candidate queues; writes
+	// reportFileName on the way out (success or failure).
+	bool MapWithPins(CGRA *cgra, DFG *dfg);
+
+	// Build the mapping from pins + routes, check it, do not search.
+	bool VerifyMap(CGRA *cgra, DFG *dfg);
+
+	bool restrictDestinations(DFGNode *node, std::priority_queue<dest_with_cost> &estimatedRoutes) override;
+
+private:
+	void writeReport(bool ok, CGRA *cgra);
+	MapConflict &addConflict(const std::string &type, int x, int y, int cycle, int from, int to,
+							 const std::string &port, const std::string &msg);
+
+	// marks one edge as the thing a caller should release to make progress
+	void noteSuggest(MapConflict &cf, int from, int to, bool flexible);
+
+	bool locateDP(int x, int y, int t, DFGNode *node, DataPath **out);
+	bool dfsExplicit(int hopIdx, int hops, Port *cur, int lat, int endLat,
+					 const RouteHint &h, Port *endPort, std::vector<LatPort> &path,
+					 std::set<std::pair<Port *, int>> &seen, int depth,
+					 DFGNode *owner = NULL, int regHops = 0);
+	bool buildExplicitPath(DFGNode *src, DFGNode *dst, const RouteHint &h,
+						   int startLat, int endLat, std::vector<LatPort> &path);
+	void checkPortOveruse();
+
+	// The simulator asserts on two operand-side situations that the port graph
+	// hides, so they are checked here instead of being discovered by a crash:
+	//  - SELECT takes exactly one valid operand (CGRATile.cpp:175)
+	//  - an input register receives at most one value per cycle (CGRATile.cpp:352)
+	void checkOperandExclusivity(DFG *dfg);
+	void checkInputExclusivity();
+
+	// arrival cycle of the value an edge delivers, keyed by (from node, to node)
+	std::map<std::pair<int, int>, int> edgeArrival;
+
+	std::map<int, PlacementPin> pins;
+	std::map<std::pair<int, int>, RouteHint> routeHints;
+	std::set<std::pair<int, int>> flexEdges;
+	std::map<std::pair<int, int>, int> edgeSlack;
+	std::vector<std::pair<int, int>> suggestEdges;
+	int flexRerouted = 0;
+	std::vector<MapConflict> conflicts;
+	std::string pinsFileName;
+	std::string routesFileName;
+	std::string reportFileName;
+	PinsMode pinsMode = PINS_OFF;
+	bool verifyMode = false;
+	int pinsApplied = 0;
+	int pinsRejected = 0;
+	int routesApplied = 0;
+	int routesRejected = 0;
+};
+
+} /* namespace CGRAXMLCompile */
+
+#endif /* LLMMAPPER_H_ */
